# Firebase Admin SDK (proyecto de Firestore). Vienen del JSON de la cuenta de servicio:
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID="tubolsillo-xxxxx"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tubolsillo-xxxxx.iam.gserviceaccount.com"
# Pega la private_key del JSON tal cual, entre comillas dobles (conserva los \n literales)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX...\n-----END PRIVATE KEY-----\n"

# Secret para firmar el token de sesion del participante (cadena larga aleatoria)
SESSION_SECRET="cambiar-por-un-string-largo-aleatorio"

# Password del dashboard /admin
ADMIN_PASSWORD="cambiar-antes-del-evento"

# URL publica de la app (para generar los QR). Ej: https://tubolsillo.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
